# The application reads environment variables; it does not load .env itself.
# To run locally, execute these commands from the repository root:
#   cp .env.example .env
#   set -a
#   . ./.env
#   set +a
#   dotnet run --project backend/src/SkyRoute.Api --launch-profile http
#
# true: register all four fake integrations.
# false, missing or invalid: no integrations are registered.
# Real adapters are not implemented yet.
# Docker Compose does not currently forward this setting to the API container.
UseFakes=true