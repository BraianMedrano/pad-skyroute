# The application reads environment variables; it does not load .env itself.
# To run locally, execute these commands from the repository root:
#   cp -n .env.example .env
#   set -a
#   . ./.env
#   set +a
#   dotnet run --project backend/src/SkyRoute.Api --launch-profile http
#
# true: register all four fake integrations.
# false: register Open-Meteo weather, RENAPER identity and Padi payment adapters.
# missing or invalid: no integrations are registered.
# Docker Compose reads .env and forwards UseFakes (default: true),
# Renaper__*, Padi__ApiKey, Padi__BaseUrl and Weather__* to the API container.

UseFakes=true

# Open-Meteo thresholds, used only when UseFakes=false.
Weather__MaxWindSpeedKmh=30
Weather__MaxPrecipitationMm=0

# RENAPER configuration, used only when UseFakes=false.
Renaper__BaseUrl=https://api-openrenaper.matiasagustinibanez.com

# Padi configuration, used only when UseFakes=false.
Padi__ApiKey=replace-with-your-Padi-server-api-key
Padi__BaseUrl=https://padi.runasp.net
