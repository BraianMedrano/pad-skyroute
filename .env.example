# The application reads environment variables; it does not load .env itself.
# To run locally, execute these commands from the repository root:
#   cp -n .env.example .env
#   set -a
#   . ./.env
#   set +a
#   dotnet run --project backend/src/SkyRoute.Api --launch-profile http
#
# true: register all four fake integrations.
# false: register only the real Padi payment adapter.
# missing or invalid: no integrations are registered.
# Docker Compose forwards UseFakes (default: true), but not Padi__ApiKey, Padi__BaseUrl, or Padi__TtlMinutes.
UseFakes=true

# Padi configuration, used only when UseFakes=false.
Padi__ApiKey=replace-with-your-Padi-server-api-key
Padi__BaseUrl=https://padi.runasp.net
