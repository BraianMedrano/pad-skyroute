# The application reads environment variables; it does not load .env itself.
# To run locally, execute these commands from the repository root:
#   cp .env.example .env
#   set -a
#   . ./.env
#   set +a
#   dotnet run --project backend/src/SkyRoute.Api --launch-profile http
#
# true: register all four fake integrations.
# false: register the real Open-Meteo and RENAPER integrations.
# missing or invalid: no integrations are registered.
# Docker Compose forwards UseFakes to the API container (default true).
UseFakes=true
Weather__MaxWindSpeedKmh=30
Weather__MaxPrecipitationMm=0

Renaper__BaseUrl=https://api-openrenaper.matiasagustinibanez.com
